---
import { DocsSidebar } from "@/components/docs-sidebar";
import { getDocsTree } from "@/lib/sources";

const sections = getDocsTree();
---

<div class="mx-auto w-full max-w-6xl px-6 pb-20 pt-12 sm:px-8 lg:px-10 lg:pt-16">
  <div class="grid gap-12 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16">
    <aside>
      <DocsSidebar client:load sections={sections} currentPath={Astro.url.pathname} />
    </aside>
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</div>
