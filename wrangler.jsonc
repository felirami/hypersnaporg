{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypersnap-web-canary",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
}
